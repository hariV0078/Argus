# Copy to .env (gitignored — never commit it):
#   cp .env.example .env
# then fill in NGROK_AUTHTOKEN from https://dashboard.ngrok.com/get-started/your-authtoken

# Required to start the tunnel (scripts/start_ngrok.py)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Reserved static domain (free tier gives one per account) — already
# reserved for this project, no need to change:
NGROK_DOMAIN=sound-guiding-mammoth.ngrok-free.app

# Local port the FastAPI server listens on / the tunnel forwards to
BACKEND_PORT=8765
