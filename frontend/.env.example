# Copy to .env (gitignored — never commit it) to pre-fill the backend URL
# at build time instead of typing it into the app's Home/Settings screen
# every time. Optional: the app also lets you set/override this on-device.
#
# Recommended: the backend's reserved ngrok static domain. Works from any
# network (phone doesn't need to be on the same Wi-Fi as the backend host),
# and sidesteps WSL2's NAT entirely — see backend/scripts/start_ngrok.py.
EXPO_PUBLIC_BACKEND_URL=https://sound-guiding-mammoth.ngrok-free.app

# Alternative for same-Wi-Fi testing without the tunnel running:
#   - Same machine, browser/simulator only: http://localhost:8765
#   - Physical phone over Wi-Fi:            http://<lan-ip-of-backend-host>:8765
# Running the backend under WSL2: WSL2's own IP (`hostname -I`) is usually
# NOT reachable from other devices on the LAN (NAT). Use the Windows host's
# LAN IP (`ipconfig`), forward/allow port 8765 through Windows Firewall into
# WSL2, or enable WSL2 "mirrored" networking (Windows 11 23H2+).
