# Copy to .env.local (gitignored) to pre-fill the backend URL at build time
# instead of typing it into the app's Home screen every time. Optional: the
# app also lets you set/override this at runtime.
#
# Recommended: the backend's reserved ngrok static domain. Works from any
# network, and sidesteps WSL2's NAT entirely — see backend/scripts/start_ngrok.py.
VITE_BACKEND_URL=https://sound-guiding-mammoth.ngrok-free.app

# Alternative for local testing without the tunnel:
#   VITE_BACKEND_URL=http://localhost:8765
