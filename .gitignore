# Argus monorepo root ignore rules
# Keep application source, configuration, documentation, and frontend assets
# trackable. Ignore machine-local, generated, secret, and very large artifacts.

# -----------------------------------------------------------------------------
# Operating system and editor files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.swn
*.tmp
*.bak
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# -----------------------------------------------------------------------------
# Secrets and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.jks
secrets.json
credentials.json

# -----------------------------------------------------------------------------
# Python and backend tooling
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
*.egg
*.whl
build/
dist/
.eggs/
pip-wheel-metadata/

# Virtual environments and local Conda environments
.venv/
venv/
env/
ENV/
*.conda/
conda-meta/
envs/

# -----------------------------------------------------------------------------
# Backend runtime data and generated reconstruction artifacts
# -----------------------------------------------------------------------------
/backend/data/raw/
/backend/data/frames/
/backend/data/masks/
/backend/data/semantic/
/backend/data/sfm/
/backend/data/mvs/
/backend/data/output/
/backend/data/logs/
/backend/data/odm_dataset/
/backend/data/**/*.db
/backend/data/**/*.sqlite
/backend/data/**/*.sqlite3
/backend/data/**/*.ply
/backend/data/**/*.las
/backend/data/**/*.laz
/backend/data/**/*.tif
/backend/data/**/*.tiff
/backend/data/**/*.glb
/backend/data/**/*.fbx
/backend/data/**/*.obj
/backend/data/**/*.mtl
/backend/data/**/*.bin
/backend/data/**/*.jpg
/backend/data/**/*.jpeg
/backend/data/**/*.png
/backend/data/**/*.mov
/backend/data/**/*.mp4
/backend/data/**/*.avi

# Preserve small, intentional directory placeholders.
!/backend/data/**/.gitkeep

# Model weights and other downloaded/vendor binaries. Keep source code and
# configuration under backend/tools/ and backend/weights/ trackable.
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
/backend/weights/
/backend/tools/sam2_weights/
/backend/tools/yolo_weights/
/backend/tools/OpenMVS/build/

# -----------------------------------------------------------------------------
# Node, Expo, React Native, and Vite outputs
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.yarn/
.pnp.*
.expo/
.expo-shared/
.metro-health-check*
.parcel-cache/
.turbo/
.cache/
web-build/
/frontend/dist/
/frontend_web/dist/
/frontend_web/dist-ssr/
/frontend/ios/
/frontend/android/
*.tsbuildinfo

# Native signing and generated mobile build files
*.mobileprovision
*.orig.*

# -----------------------------------------------------------------------------
# Notebooks, logs, reports, and temporary exports
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.log
logs/
tmp/
temp/
*.prof
*.sqlite
*.sqlite3
*.db-journal

# Archives and downloaded datasets
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.iso
*.weights

# Windows alternate data streams accidentally copied into the repository
*:Zone.Identifier
